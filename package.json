{
  "name": "thumbnail-cdk-devcontainer-sample",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "node --test --test-concurrency=1 --import tsx test/*.test.ts",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy --require-approval never -c stage=dev",
    "deploy:stg": "cdk deploy --require-approval never -c stage=stg"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^20.16.5",
    "aws-cdk": "^2.157.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.667.0",
    "@aws-sdk/s3-request-presigner": "^3.667.0",
    "aws-cdk-lib": "^2.157.0",
    "constructs": "^10.3.0",
    "sharp": "^0.33.5"
  }
}
